{
  "name": "bread-or-dead",
  "version": "1.0.0",
  "private": true,
  "description": "Bread or Dead — physics-based bread social deduction, in a kitchen.",
  "type": "module",
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "concurrently -n server,client -c yellow,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --workspace server run dev",
    "dev:client": "npm --workspace client run dev",
    "build": "npm --workspace client run build",
    "start": "npm --workspace server run start",
    "preview": "npm run build && npm start"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": { "node": ">=18" }
}
